# GEMINI_API_KEY: Required for Gemini AI API calls (TTS, Voice Cloning analysis, Localization, and STT).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CARTESIA_API_KEY: Optional direct Cartesia Sonic API key (https://api.cartesia.ai).
# When configured in Secrets, /api/cartesia/tts can proxy directly to api.cartesia.ai/tts/bytes
# with automatic fallback to the built-in Gemini 3.8 Flash TTS engine.
CARTESIA_API_KEY="MY_CARTESIA_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
